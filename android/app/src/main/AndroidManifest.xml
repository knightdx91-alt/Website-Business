<?xml version="1.0" encoding="utf-8"?>
<!-- Website Business, the native Android app: leads, call log, tasks, alerts, Tap to Pay. It talks to the same Worker
     API as the web app; long-tail screens (site editor, inbox, sales dashboard, settings) open the web app inside the
     app's own WebView with the same login. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Team alerts (new notes, calls, sales, sign-ups, preview opens). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Tap to Pay: Stripe requires the phone's location while taking a payment. -->
    <!-- tools:node="replace": a library declares this with maxSdkVersion=30, which would leave Tap to Pay without location on Android 13+. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" tools:node="replace" />
    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- In-app updates: the app downloads the new build and asks Android to install it. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/appName"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/appName"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Also reachable from the web app (intent://tap?t=…#Intent;scheme=wbpay;package=…;end) when a sign-up page is open in Chrome. -->
        <activity
            android:name=".tap.TapToPayActivity"
            android:exported="true"
            android:label="@string/tapTitle"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="wbpay" android:host="tap" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
